pipeline {
    agent any

    environment {
        WORKSPACE_DIR = 'azure'
        KUBECONFIG_LOCATION = 'kubeconfig' // config path for kubernetes

        ACR_NAME = 'likemindsloadregistry'
        ACR_LOGIN_SERVER = 'likemindsloadregistry.azurecr.io'

        RESOURCE_GROUP = 'likeminds-load-resource-group'
        AKS_CLUSTER = 'likeminds-load-k8s-cluster'
    }

    parameters {
        choice(name: 'action', choices: ['plan', 'apply', 'destroy'], description: 'Terraform action - plan/apply/destroy')

        string(name: 'kettle_branch', defaultValue: 'development', description: 'Kettle branch')
        string(name: 'swarm_branch', defaultValue: 'development', description: 'Swarm branch')
        string(name: 'caravan_branch', defaultValue: 'development', description: 'Caravan branch')
        string(name: 'skulk_branch', defaultValue: 'development', description: 'Skulk Celery branch')

        booleanParam(name: 'enable_kettle', defaultValue: false, description: 'Enable Kettle for deployment')
        booleanParam(name: 'enable_swarm', defaultValue: false, description: 'Enable Swarm for deployment')
        booleanParam(name: 'enable_caravan', defaultValue: false, description: 'Enable Caravan for deployment')
        booleanParam(name: 'enable_skulk', defaultValue: false, description: 'Build Skulk & push Docker image')

        booleanParam(name: 'build_kettle', defaultValue: false, description: 'Build Kettle & push Docker image')
        booleanParam(name: 'build_swarm', defaultValue: false, description: 'Build Swarm & push Docker image')
        booleanParam(name: 'build_caravan', defaultValue: false, description: 'Build Caravan & push Docker image')
        // booleanParam(name: 'build_skulk', defaultValue: false, description: 'Build Skulk & push Docker image')
    }

    stages {
        
        stage("Checkout") {
            steps {
                checkout scm
                echo "-------------------------Checkout Main Branch stage completed-------------------------"
            }
        }

        stage("Set Azure Environment Variables") {
            steps {
                script {
                    withCredentials([azureServicePrincipal('azure-load-sp-creds')]) {
                        env.ARM_CLIENT_ID = "$AZURE_CLIENT_ID"
                        env.ARM_CLIENT_SECRET = "$AZURE_CLIENT_SECRET"
                        env.ARM_SUBSCRIPTION_ID = "$AZURE_SUBSCRIPTION_ID"
                        env.ARM_TENANT_ID = "$AZURE_TENANT_ID"

                        env.KUBECONFIG = "${env.KUBECONFIG_LOCATION}"
                    }

                }
                echo "-------------------------Set Azure Enviornment variables stage completed-------------------------"
            }
        }

        stage("Azure login & kubectl context set") {
            steps {
                script {
                    dir("${env.WORKSPACE_DIR}"){
                        sh '''
                            az login --service-principal -u $ARM_CLIENT_ID -p $ARM_CLIENT_SECRET --t $ARM_TENANT_ID

                            az aks get-credentials --resource-group $RESOURCE_GROUP --name $AKS_CLUSTER --overwrite-existing --file $KUBECONFIG

                            kubelogin convert-kubeconfig -l spn --client-id $ARM_CLIENT_ID --client-secret $ARM_CLIENT_SECRET
                        '''

                    }
                    echo "-------------------------Azure login & kubelogin stage completed-------------------------"
                }
            }
        }

        stage("Build Kettle Docker Image") {
            when {
                expression {
                    return params.build_kettle
                }
            }
            steps {
                script {
                    dir('likeminds-authentication') {
                        git branch: "${params.kettle_branch}", credentialsId: 'gitHub-ssh-shubh	', url: 'git@github.com:NateshR/likeMinds-authentication.git'
                        echo 'Kettle code cloned'

                        echo "Infisical Login and .ENV exports step"
                        withCredentials([usernamePassword(credentialsId: 'infisical-identity-creds', usernameVariable: 'INFISICAL_CLIENT_ID', passwordVariable: 'INFISICAL_CLIENT_SECRET')]) {
                            sh '''
                                INFISICAL_TOKEN=$(infisical login --method=universal-auth --client-id=$INFISICAL_CLIENT_ID --client-secret=$INFISICAL_CLIENT_SECRET --silent --plain)
                                infisical export --env=load --projectId=936af601-d912-416b-958f-35f09a21309f > .env --token=$INFISICAL_TOKEN
                            '''
                        }
                        echo 'Infisical Login and .ENV exports step completed'

                        // Build and push the Docker image 
                        echo "Build and push the Docker image"
                        sh '''
                            az acr login --name $ACR_NAME
                            docker build -t $ACR_LOGIN_SERVER/likeminds-authentication/kettle:latest -f Dockerfile.kettle-load .
                            docker push $ACR_LOGIN_SERVER/likeminds-authentication/kettle:latest
                            docker rmi $ACR_LOGIN_SERVER/likeminds-authentication/kettle:latest
                        '''
                        echo "Build and push the Docker image Completed"
                    }

                echo '-------------------------Kettle Docker Image Stage completed-------------------------'
                }  
            }
        }

        stage("Build Swarm Docker Image") {
            when {
                expression {
                    return params.build_swarm
                }
            }
            steps {
                script {
                    dir('likeminds-swarm') {
                        git branch: "${params.swarm_branch}", credentialsId: 'gitHub-ssh-shubh	', url: 'git@github.com:NateshR/likeMinds-swarm.git'
                        echo 'swarm code cloned'

                        echo "Infisical Login and .ENV exports step"
                        withCredentials([usernamePassword(credentialsId: 'infisical-identity-creds', usernameVariable: 'INFISICAL_CLIENT_ID', passwordVariable: 'INFISICAL_CLIENT_SECRET')]) {
                            sh '''
                                mkdir -p ./cmd/server/config
                                INFISICAL_TOKEN=$(infisical login --method=universal-auth --client-id=$INFISICAL_CLIENT_ID --client-secret=$INFISICAL_CLIENT_SECRET --silent --plain)
                                infisical export --env=load --projectId=65366600-18f7-4041-88c3-7e73c0fbbc83 > ./cmd/server/config/.env --token=$INFISICAL_TOKEN
                            '''
                        }
                        echo 'Infisical Login and .ENV exports step completed'

                        // Build and push the Docker image 
                        echo "Build and push the Docker image"
                        sh '''
                            az acr login --name $ACR_NAME
                            docker build -t $ACR_LOGIN_SERVER/likeminds-swarm/swarm:latest -f Dockerfile.swarm-load .
                            docker push $ACR_LOGIN_SERVER/likeminds-swarm/swarm:latest
                            docker rmi $ACR_LOGIN_SERVER/likeminds-swarm/swarm:latest
                        '''
                        echo "Build and push the Docker image Completed"
                    }

                echo '-------------------------Swarm Docker Image Stage completed-------------------------'
                }  
            }
        }

        stage("Build Swarm-worker Docker Image") {
            when {
                expression {
                    return params.build_swarm
                }
            }
            steps {
                script {
                    dir('likeminds-swarm-worker') {
                        git branch: "${params.swarm_branch}", credentialsId: 'gitHub-ssh-shubh	', url: 'git@github.com:NateshR/likeMinds-swarm.git'
                        echo 'swarm code cloned'

                        echo "Infisical Login and .ENV exports step"
                        withCredentials([usernamePassword(credentialsId: 'infisical-identity-creds', usernameVariable: 'INFISICAL_CLIENT_ID', passwordVariable: 'INFISICAL_CLIENT_SECRET')]) {
                            sh '''
                                mkdir -p ./cmd/server/config
                                INFISICAL_TOKEN=$(infisical login --method=universal-auth --client-id=$INFISICAL_CLIENT_ID --client-secret=$INFISICAL_CLIENT_SECRET --silent --plain)
                                infisical export --env=load --projectId=65366600-18f7-4041-88c3-7e73c0fbbc83 > ./cmd/server/config/.env --token=$INFISICAL_TOKEN
                            '''
                        }
                        echo 'Infisical Login and .ENV exports step completed'

                        // Build and push the Docker image 
                        echo "Build and push the Docker image"
                        sh '''
                            az acr login --name $ACR_NAME
                            docker build -t $ACR_LOGIN_SERVER/likeminds-swarm/swarm-worker:latest -f Dockerfile.swarm-worker-load .
                            docker push $ACR_LOGIN_SERVER/likeminds-swarm/swarm-worker:latest
                            docker rmi $ACR_LOGIN_SERVER/likeminds-swarm/swarm-worker:latest
                        '''
                        echo "Build and push the Docker image Completed"
                    }

                echo '-------------------------Swarm-worker Docker Image Stage completed-------------------------'
                }  
            }
        }

        stage("Build Caravan Docker Image") {
            when {
                expression {
                    return params.build_caravan
                }
            }
            steps {
                script {
                    dir('likeminds-caravan') {
                        git branch: "${params.caravan_branch}", credentialsId: 'gitHub-ssh-shubh', url: 'git@github.com:NateshR/togther.git'
                        echo 'Caravan code cloned'

                        echo "Infisical Login and .ENV exports step"
                        withCredentials([usernamePassword(credentialsId: 'infisical-identity-creds', usernameVariable: 'INFISICAL_CLIENT_ID', passwordVariable: 'INFISICAL_CLIENT_SECRET')]) {
                            sh '''
                                INFISICAL_TOKEN=$(infisical login --method=universal-auth --client-id=$INFISICAL_CLIENT_ID --client-secret=$INFISICAL_CLIENT_SECRET --silent --plain)
                                infisical export --env=load --projectId=cc310d9a-779b-4218-8e25-3fb6c152ecbb > ./project/project/settings/.env --token=$INFISICAL_TOKEN
                                cat ./project/project/settings/.env
                            '''
                        }
                        echo 'Infisical Login and .ENV exports step completed'


                        // Build and push the Docker image
                        echo "Build and push the Docker image" 
                        sh '''
                            az acr login --name $ACR_NAME
                            docker build -t $ACR_LOGIN_SERVER/togther/caravan:latest -f Dockerfile.caravan-load .
                            docker push $ACR_LOGIN_SERVER/togther/caravan:latest
                            docker rmi $ACR_LOGIN_SERVER/togther/caravan:latest
                        '''
                        echo "Build and push the Docker image Completed"

                        // Manually Run Migrations Step
                    }

                    echo '-------------------------Caravan Docker Image Stage completed-------------------------'
                }
            }
        }

        stage("Build Caravan Celery Docker Image") {
            when {
                expression {
                    return params.build_caravan
                }
            }
            steps {
                script {
                    dir('likeminds-caravan-celery') {
                        git branch: "${params.caravan_branch}", credentialsId: 'gitHub-ssh-shubh', url: 'git@github.com:NateshR/togther.git'
                        echo 'Caravan-Celery code cloned'

                        echo "Infisical Login and .ENV exports step"
                        withCredentials([usernamePassword(credentialsId: 'infisical-identity-creds', usernameVariable: 'INFISICAL_CLIENT_ID', passwordVariable: 'INFISICAL_CLIENT_SECRET')]) {
                            sh '''
                                INFISICAL_TOKEN=$(infisical login --method=universal-auth --client-id=$INFISICAL_CLIENT_ID --client-secret=$INFISICAL_CLIENT_SECRET --silent --plain)
                                infisical export --env=load --projectId=936af601-d912-416b-958f-35f09a21309f  > ./project/project/settings/.env --token=$INFISICAL_TOKEN
                            '''
                        }
                        echo 'Infisical Login and .ENV exports step completed'

                        // Build and push the Docker image 
                        echo "Build and push the Docker image"
                        sh '''
                            az acr login --name $ACR_NAME
                            docker build -t $ACR_LOGIN_SERVER/togther/caravan-celery:latest -f Dockerfile.caravan-celery-load .
                            docker push $ACR_LOGIN_SERVER/togther/caravan-celery:latest
                            docker rmi $ACR_LOGIN_SERVER/togther/caravan-celery:latest
                        '''
                        echo "Build and push the Docker image Completed"
                    }

                    echo '-------------------------Caravan-Celery Docker Image Stage completed-------------------------'
                }
            }
        }

        stage("Build Skulk Docker Image") {
            when {
                expression {
                    return params.build_skulk
                }
            }
            steps {
                script {
                    dir('likeminds-skulk') {
                        git branch: "${params.skulk_branch}", credentialsId: 'gitHub-ssh-shubh', url: 'git@github.com:NateshR/likeminds-subscription.git'
                        echo 'skulk code cloned'

                        // Add .env file

                        // Build and push the Docker image
                        echo "Build and push the Docker image" 
                        sh '''
                            az acr login --name $ACR_NAME
                            docker build -t $ACR_LOGIN_SERVER/likeminds-subscription/skulk:latest -f Dockerfile.skulk-load .
                            docker push $ACR_LOGIN_SERVER/likeminds-subscription/skulk:latest
                            docker rmi $ACR_LOGIN_SERVER/likeminds-subscription/skulk:latest
                        '''
                        echo "Build and push the Docker image Completed"

                        // Add Run Migrations Step
                    }

                    echo '-------------------------Skulk Docker Image Stage completed-------------------------'
                }
            }
        }

        stage("Terraform action"){
            steps{
                script{
                    dir("${env.WORKSPACE_DIR}"){
                    
                        def terraformVars = ""

                        // Terraform variables for the action if not empty
                        if (isNotEmpty(env.resource_group_name)) terraformVars += "-var 'resource_group_name=${env.resource_group_name}' "
                        if (isNotEmpty(env.resource_location)) terraformVars += "-var 'resource_location=${env.resource_location}' "
                        if (isNotEmpty(env.aks_cluster_name)) terraformVars += "-var 'aks_cluster_name=${env.aks_cluster_name}' "
                        if (isNotEmpty(env.namespace_name)) terraformVars += "-var 'namespace_name=${env.namespace_name}' "
                        if (isNotEmpty(env.kettle_cpu)) terraformVars += "-var 'kettle_cpu=${env.kettle_cpu}' "
                        if (isNotEmpty(env.kettle_memory)) terraformVars += "-var 'kettle_memory=${env.kettle_memory}' "
                        if (isNotEmpty(env.kettle_pods)) terraformVars += "-var 'kettle_pods=${env.kettle_pods}' "
                        if (isNotEmpty(env.swarm_cpu)) terraformVars += "-var 'swarm_cpu=${env.swarm_cpu}' "
                        if (isNotEmpty(env.swarm_memory)) terraformVars += "-var 'swarm_memory=${env.swarm_memory}' "
                        if (isNotEmpty(env.swarm_pods)) terraformVars += "-var 'swarm_pods=${env.swarm_pods}' "
                        if (isNotEmpty(env.swarm_worker_cpu)) terraformVars += "-var 'swarm_worker_cpu=${env.swarm_worker_cpu}' "
                        if (isNotEmpty(env.swarm_worker_memory)) terraformVars += "-var 'swarm_worker_memory=${env.swarm_worker_memory}' "
                        if (isNotEmpty(env.swarm_worker_pods)) terraformVars += "-var 'swarm_worker_pods=${env.swarm_worker_pods}' "
                        if (isNotEmpty(env.caravan_cpu)) terraformVars += "-var 'caravan_cpu=${env.caravan_cpu}' "
                        if (isNotEmpty(env.caravan_memory)) terraformVars += "-var 'caravan_memory=${env.caravan_memory}' "
                        if (isNotEmpty(env.caravan_pods)) terraformVars += "-var 'caravan_pods=${env.caravan_pods}' "
                        if (isNotEmpty(env.caravan_celery_cpu)) terraformVars += "-var 'caravan_celery_cpu=${env.caravan_celery_cpu}' "
                        if (isNotEmpty(env.caravan_celery_memory)) terraformVars += "-var 'caravan_celery_memory=${env.caravan_celery_memory}' "
                        if (isNotEmpty(env.caravan_celery_pods)) terraformVars += "-var 'caravan_celery_pods=${env.caravan_celery_pods}' "
                        if (isNotEmpty(env.caravan_celery_broker_url)) terraformVars += "-var 'caravan_celery_broker_url=${env.caravan_celery_broker_url}' "
                        if (isNotEmpty(env.caravan_rabbitmq_username)) terraformVars += "-var 'caravan_rabbitmq_username=${env.caravan_rabbitmq_username}' "
                        if (isNotEmpty(env.caravan_rabbitmq_password)) terraformVars += "-var 'caravan_rabbitmq_password=${env.caravan_rabbitmq_password}' "
                        if (isNotEmpty(env.skulk_cpu)) terraformVars += "-var 'skulk_cpu=${env.skulk_cpu}' "
                        if (isNotEmpty(env.skulk_memory)) terraformVars += "-var 'skulk_memory=${env.skulk_memory}' "
                        if (isNotEmpty(env.skulk_pods)) terraformVars += "-var 'skulk_pods=${env.skulk_pods}' "

                        // Enable parameters
                        if (params.enable_kettle) terraformVars += "-var 'enable_kettle=${params.enable_kettle}' "
                        if (params.enable_swarm) terraformVars += "-var 'enable_swarm=${params.enable_swarm}' "
                        if (params.enable_caravan) terraformVars += "-var 'enable_caravan=${params.enable_caravan}' "
                        if (params.enable_skulk) terraformVars += "-var 'enable_skulk=${params.enable_skulk}' "

                        echo "Terraform Vars: ${terraformVars}"

                        if (params.action == 'plan') {
                            sh """
                                terraform init
                                terraform ${params.action} ${terraformVars}
                            """
                        } else {
                            sh """
                                terraform init
                                terraform ${params.action} --auto-approve ${terraformVars}
                            """
                        }
                    }
                }

            }
        }
    }
}

// Helper function to check if value is not null or empty (Handles single/double quotes)
def isNotEmpty(value){ 
    if (value == null) {
        return false
    }

    // Remove surrounding single quotes if they exist
    value = value.replaceAll(/^['"]|['"]$/, '').trim()
    if (value.isEmpty()) {
        return false
    } else {
        return true
    }
}
